{
  "standard.version": "0.4",
  "tool.name": "cep_lint",
  "tool.version": "0.4.0",
  "file_globs": [
    "*.rs"
  ],
  "fail_on": [
    0,
    1
  ],
  "doc_sync": {
    "doc_path": "standards.md",
    "heading_pattern": "^### Rule (CEP-LINT-[A-Z-]+)$",
    "version_pattern": "^Version: \\*\\*([0-9.]+)\\*\\*$"
  },
  "rules": {
    "CEP-LINT-FILE-HEADER": {
      "severity": 1,
      "check": "comment_block_schema",
      "mode": "file_header",
      "required_fields": [
        "CEP:FILE",
        "CEP:WHAT",
        "CEP:WHY",
        "CEP:CLASS",
        "CEP:STATUS",
        "CEP:FAILURE",
        "CEP:ASSUMES",
        "CEP:COST",
        "CEP:EVIDENCE"
      ],
      "class_field": "CEP:CLASS",
      "allowed_classes": [
        "CEP-0",
        "CEP-1",
        "CEP-2",
        "CC",
        "FFI",
        "HPC-0",
        "HPC-1",
        "HPC-2",
        "RCS-0",
        "RCS-1",
        "RCS-2",
        "FV-0",
        "FV-1",
        "FV-2"
      ],
      "max_start_line": 1
    },
    "CEP-LINT-FUNC-BLOCK": {
      "severity": 1,
      "check": "function_policy",
      "mode": "block",
      "required_fields": [
        "CEP:WHAT",
        "CEP:WHY",
        "CEP:STATUS",
        "CEP:FAILURE",
        "CEP:ASSUMES",
        "CEP:COST",
        "CEP:EVIDENCE"
      ],
      "min_body_statements": 2,
      "gap_pattern": "^(#\\[|///|\\}\\)|where|->|pub fn|fn |unsafe fn|const fn|extern )",
      "require_block_for_lambdas": false
    },
    "CEP-LINT-STATUS-VALUE": {
      "severity": 2,
      "check": "comment_block_schema",
      "mode": "status_value",
      "status_field": "CEP:STATUS",
      "allowed_values": [
        "complete",
        "partial",
        "stub",
        "placeholder"
      ]
    },
    "CEP-LINT-TODO-OWNER": {
      "severity": 1,
      "check": "comment_regex",
      "scope": "line",
      "pattern": "(TODO|FIXME|XXX|HACK)",
      "icase": true,
      "suppression_pattern": "^CEP:TODO\\([^)]*\\):\\s*CEP-[A-Z0-9]+:"
    },
    "CEP-LINT-STUB-DECL": {
      "severity": 1,
      "check": "comment_block_schema",
      "mode": "stub_requirements",
      "status_field": "CEP:STATUS",
      "statuses": [
        "stub",
        "partial",
        "placeholder"
      ],
      "required_fields": [
        "CEP:OWNER",
        "CEP:TICKET"
      ]
    },
    "CEP-LINT-PLACEHOLDER-COMMENT": {
      "severity": 1,
      "check": "comment_regex",
      "scope": "line",
      "pattern": "(not implemented|unimplemented|placeholder|fixme|tbd|wip)",
      "icase": true,
      "suppression_pattern": "^\\s*CEP:"
    },
    "CEP-LINT-PLACEHOLDER-TEXT": {
      "severity": 1,
      "check": "string_literal_regex",
      "pattern": "(not implemented|unimplemented|placeholder|fixme|tbd|wip)",
      "icase": true
    },
    "CEP-LINT-MAGIC-NUMBER": {
      "severity": 2,
      "check": "numeric_literal_policy",
      "allowed_values": [
        0,
        1
      ],
      "exempt_contexts": [
        "\\bconst\\b",
        "\\bstatic\\b",
        "\\benum\\b",
        "\\bstruct\\b",
        "#\\[",
        "^\\s*//",
        "\\\\.\\."
      ]
    },
    "CEP-LINT-MACRO-PREFIX": {
      "severity": 2,
      "check": "macro_prefix_policy",
      "name_pattern": "^CEP_[A-Z0-9_]+$",
      "guard_pattern": "^_CEP_[A-Z0-9_]+$"
    },
    "CEP-LINT-HOT-BANNED": {
      "severity": 0,
      "check": "banned_token_policy",
      "applies_to_classes": [
        "CEP-0",
        "HPC-0",
        "RCS-0"
      ],
      "class_field": "CEP:CLASS",
      "tokens": [
        "Box::new",
        "Vec::",
        "String::",
        "format!",
        "println!",
        "eprintln!",
        "panic!",
        "todo!",
        "unimplemented!",
        ".unwrap()",
        ".expect(",
        "Rc::",
        "Arc::",
        "Mutex",
        "RwLock",
        "dyn ",
        "async ",
        "std::",
        "thread::spawn"
      ]
    },
    "CEP-LINT-STUB-BODY": {
      "severity": 1,
      "check": "function_policy",
      "mode": "stub_body",
      "suppress_status_field": "CEP:STATUS",
      "suppress_statuses": [
        "stub",
        "partial",
        "placeholder"
      ]
    },
    "CEP-LINT-EMPTY-CATCH": {
      "severity": 1,
      "check": "flat_code_regex",
      "pattern": "catch\\s*\\([^)]*\\)\\s*\\{\\s*\\}"
    },
    "CEP-LINT-EMPTY-BRANCH": {
      "severity": 2,
      "check": "flat_code_regex",
      "pattern": "\\b(if|for|while|match)\\b[^\\{;]*\\{\\s*\\}"
    },
    "CEP-LINT-CONSTANT-RETURN": {
      "severity": 2,
      "check": "function_policy",
      "mode": "constant_return",
      "pattern": "^fn\\s+[a-z0-9_]+\\s*\\([^)]*\\)\\s*->\\s*bool\\s*\\{\\s*(true|false)\\s*\\}$"
    },
    "CEP-LINT-NAMING-TYPE": {
      "severity": 2,
      "check": "name_validation_regex",
      "pattern": "\\b(struct|enum|union)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "line_group": 2,
      "name_pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "CEP-LINT-NAMING-FUNC": {
      "severity": 2,
      "check": "function_policy",
      "mode": "naming",
      "name_pattern": "^[a-z_][a-z0-9_]*$"
    },
    "CEP-LINT-COMMENTED-CODE": {
      "severity": 2,
      "check": "comment_regex",
      "scope": "line",
      "pattern": "^(let |fn |pub |if |for |while |return |use |match ).*;",
      "suppression_pattern": "^CEP:"
    },
    "CEP-LINT-DOC-SYNC": {
      "severity": 1,
      "check": "doc_rule_coverage",
      "doc_path": "standards.md",
      "heading_pattern": "^### Rule (CEP-LINT-[A-Z-]+)$",
      "version_pattern": "^Version: \\*\\*([0-9.]+)\\*\\*$"
    },
    "CEP-LINT-ATOMIC-FILE": {
      "severity": 1,
      "check": "file_topology_policy",
      "line_limits": {
        "CEP-0": 400,
        "HPC-0": 400,
        "RCS-0": 400,
        "CEP-1": 800,
        "HPC-1": 800,
        "RCS-1": 800,
        "CC": 800,
        "FFI": 800,
        "CEP-2": 1200,
        "HPC-2": 1200,
        "RCS-2": 1200
      },
      "default_limit": 400,
      "junk_names": [
        "util",
        "helper",
        "misc",
        "common"
      ]
    },
    "CEP-LINT-DOC-ID": {
      "severity": 1,
      "check": "function_policy",
      "mode": "id",
      "max_id_statements": 10,
      "id_pattern": "^(JIT|IR|LEX|FE|MEM|NET|GPU|HOT|CS)-[a-z0-9]+$"
    },
    "CEP-LINT-DOC-FILE": {
      "severity": 1,
      "check": "rosetta_policy",
      "mode": "registry",
      "registry_path": "docs/registry.json",
      "docs_prefix": "docs/functions"
    },
    "CEP-LINT-DOC-TIERS": {
      "severity": 1,
      "check": "rosetta_policy",
      "mode": "tiers"
    },
    "CEP-LINT-DOC-INQUISITION": {
      "severity": 1,
      "check": "rosetta_policy",
      "mode": "inquisition"
    },
    "CEP-LINT-SECRET-SCAN": {
      "severity": 0,
      "check": "secret_probe_policy",
      "patterns": [
        "(?i)(password|passwd|secret_key|api_key|apikey|aws_secret_access_key)\\s*=\\s*['\\\"][^'\\\"]+['\\\"]",
        "-----BEGIN (RSA |EC |OPENSSH |PGP )?PRIVATE KEY-----",
        "\\bAKIA[0-9A-Z]{16}\\b"
      ],
      "exempt_paths": [],
      "suppression_pattern": "CEP:SECRET"
    },
    "CEP-LINT-UNSAFE-DOC": {
      "severity": 1,
      "check": "unsafe_doc_policy",
      "unsafe_field": "CEP:UNSAFE",
      "exempt_paths": []
    },
    "CEP-LINT-HUNT-RECEIPT": {
      "severity": 2,
      "check": "commit_hunt_manifest",
      "note": "Documented in standards 65.5; the signed-receipt CI infrastructure is deferred per ticket CEP-90 and emits one recorded-deviation finding per scan."
    },
    "CEP-LINT-BENCH-EVIDENCE": {
      "severity": 2,
      "check": "benchmark_manifest",
      "note": "Documented in standards 69.7; the PMC-backed receipt infrastructure is deferred per ticket CEP-91 (CIV-4) and emits one recorded-deviation finding per scan."
    },
    "CEP-LINT-HUNTER-RECEIPT": {
      "severity": 2,
      "check": "hunter_receipt",
      "note": "Documented in standards 67.3; deferred per ticket CEP-90."
    }
  }
}
